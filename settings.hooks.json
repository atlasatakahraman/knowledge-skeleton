{
  "SessionStart": [
    { "hooks": [{ "type": "command", "command": "{BUN} --bun {HOOKS}/brain-session.mjs" }] }
  ],
  "UserPromptSubmit": [
    { "hooks": [{ "type": "command", "command": "{BUN} --bun {HOOKS}/brain-inject.mjs" }] }
  ],
  "SessionEnd": [
    { "hooks": [{ "type": "command", "command": "{BUN} --bun {HOOKS}/brain-capture.mjs", "timeout": 10 }] }
  ],
  "PreCompact": [
    { "hooks": [{ "type": "command", "command": "{BUN} --bun {HOOKS}/brain-capture.mjs", "timeout": 10 }] }
  ],
  "Stop": [
    { "hooks": [{ "type": "command", "command": "{BUN} --bun {HOOKS}/brain-capture.mjs", "timeout": 10, "async": true }] }
  ],
  "SubagentStop": [
    { "hooks": [{ "type": "command", "command": "{BUN} --bun {HOOKS}/brain-capture.mjs", "timeout": 10, "async": true }] }
  ],
  "PostToolUse": [
    { "matcher": "Edit|Write", "hooks": [{ "type": "command", "command": "{BUN} --bun {HOOKS}/brain-reindex.mjs" }] },
    { "matcher": "Bash", "hooks": [{ "type": "command", "command": "{BUN} --bun {HOOKS}/brain-commit.mjs", "timeout": 15, "async": true }] }
  ],
  "PostToolUseFailure": [
    { "matcher": "Bash", "hooks": [{ "type": "command", "command": "{BUN} --bun {HOOKS}/brain-commit.mjs", "timeout": 15, "async": true }] }
  ]
}
